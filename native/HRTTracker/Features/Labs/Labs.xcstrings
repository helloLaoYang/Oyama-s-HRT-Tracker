    "Each lab result only affects estimates after its sample time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条化验只调整其采样时间之后的估算。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Laborwert beeinflusst nur die Schätzungen nach dem Zeitpunkt der Probenahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque résultat d’analyse ne modifie que les estimations postérieures au prélèvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各検査結果は、その採血時刻以降の推定値にのみ反映されます。"
          }
        }
      }
    },
