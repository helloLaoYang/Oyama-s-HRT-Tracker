{
  "sourceLanguage": "en",
  "strings": {
    "A bot will publish your feedback in a public issue on GitHub. You do not need a GitHub account. Please omit personal information, medication records, and lab results.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器人会将你的反馈发布为 GitHub 上的公开议题。你无需 GitHub 账号。请勿填写个人信息、用药记录或化验结果。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bot veröffentlicht dein Feedback in einem öffentlichen GitHub-Issue. Du brauchst kein GitHub-Konto. Gib bitte keine persönlichen Informationen, Medikationsdaten oder Laborergebnisse an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bot publiera votre avis dans un ticket public sur GitHub. Vous n’avez pas besoin de compte GitHub. N’indiquez aucune donnée personnelle, prise de médicaments ou résultat d’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックはボットによって GitHub の公開 Issue に投稿されます。GitHub アカウントは不要です。個人情報、服薬記録、検査結果は記載しないでください。"
          }
        }
      }
    },
    "Check your title and description, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查标题和描述，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Titel und Beschreibung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le titre et la description, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルと内容を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "Could not send your feedback. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈提交失败，请重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feedback konnte nicht gesendet werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer votre avis. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信できませんでした。もう一度お試しください。"
          }
        }
      }
    },
