    "Enter a dose greater than 0 and no more than 10000.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入大于 0 且不超过 10000 的剂量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Dosis über 0 und höchstens 10.000 ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une dose supérieure à 0 et inférieure ou égale à 10 000."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より大きく10000以下の投与量を入力してください。"
          }
        }
      }
    },
    "Enter a hold time of at least 1 minute.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入至少 1 分钟的含服时间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Haltezeit von mindestens 1 Minute ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une durée de maintien d’au moins 1 minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持時間は1分以上で入力してください。"
          }
        }
      }
    },
    "Enter a positive wear duration or leave it blank.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入大于 0 的佩戴时长，或留空。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine positive Tragedauer ein oder lass das Feld leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une durée de port positive ou laissez le champ vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より大きい貼付期間を入力するか、空欄にしてください。"
          }
        }
      }
    },
