    "Estimates are calculated from recorded doses and are separate from lab measurements.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值根据用药记录计算，与化验实测结果分开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzwerte werden anhand der dokumentierten Dosen berechnet und getrennt von Labormesswerten angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations sont calculées à partir des prises enregistrées et présentées séparément des mesures de laboratoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値は投薬記録から算出され、検査の実測値とは別に表示されます。"
          }
        }
      }
    },
