    "For example, save your preferred units or usual review period.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如，可以记住你惯用的单位或回顾范围。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere zum Beispiel bevorzugte Einheiten oder den üblichen Rückblickzeitraum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez par exemple vos unités ou votre période de récapitulatif habituelle."
