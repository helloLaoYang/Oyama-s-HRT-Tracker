    "I can help review your saved records and estimates. Take treatment decisions to your care team.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以帮助回顾已保存的记录和估算值。请与你的医疗团队讨论治疗决定。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann deine gespeicherten Aufzeichnungen und Schätzwerte zusammenfassen. Besprich Behandlungsentscheidungen mit deinem Behandlungsteam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux vous aider à revoir les relevés et estimations enregistrés. Discutez des décisions de traitement avec votre équipe soignante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した記録や推定値を振り返ることができます。治療の判断は医療チームにご相談ください。"
          }
        }
      }
    },
