    "State one replacement number in the record’s existing unit, or enter the value below.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按记录的原有单位写出一个新数值，或直接在下方输入。"
          }
        }
      }
    },
    "The record changed. Close this sheet and reopen it before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已变更。请关闭并重新打开此页面后再试。"
