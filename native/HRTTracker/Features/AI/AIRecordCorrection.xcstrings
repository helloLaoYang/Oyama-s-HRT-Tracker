{
  "sourceLanguage": "en",
  "strings": {
    "AI could not draft this correction. You can enter the new value below.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 未能生成修正草稿。你可以在下方输入新值。"
          }
        }
      }
    },
    "AI draft": {
      "extractionState": "manual",
      "localizations": {
