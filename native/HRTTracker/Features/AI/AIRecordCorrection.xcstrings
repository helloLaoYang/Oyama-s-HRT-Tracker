      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述要修正的内容"
          }
        }
      }
    },
    "Draft ready. Check the proposed value before saving.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已生成，请核对数值后保存。"
          }
        }
      }
    },
    "Draft with AI": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 AI 生成草稿"
          }
        }
      }
    },
    "Enter a different valid value without digit grouping.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入一个不同的有效数值，不使用千位分隔符。"
          }
        }
      }
    },
    "Enter a short correction with one explicit number.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请简短描述修正内容，并提供一个明确的数值。"
          }
        }
      }
    },
    "New value": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新值"
          }
        }
      }
    },
    "No records in this period can be corrected here.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时间范围内没有可在此修正的记录。"
          }
        }
      }
    },
    "Original value restored": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
