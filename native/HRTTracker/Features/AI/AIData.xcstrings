    "Model estimate for %@ at %@: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型估算 · %1$@ · %2$@：%3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellschätzung für %1$@ am %2$@: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation du modèle pour %1$@ à %2$@ : %3$@"
          }
        },
