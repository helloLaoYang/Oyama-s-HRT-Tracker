    },
    "Enter a memory of 500 characters or fewer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入一条不超过 500 字符的记忆。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Erinnerung mit höchstens 500 Zeichen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une mémoire de 500 caractères maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "500文字以内でメモリを入力してください。"
          }
        }
      }
    },
