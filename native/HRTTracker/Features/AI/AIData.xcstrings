{
  "sourceLanguage": "en",
  "strings": {
    "A lab result is measured at sample time. Concentrations on the curve are estimates calculated from dose records.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "化验结果来自采样时的实测。曲线中的浓度是根据用药记录计算的估算值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Laborwert wird anhand einer zum angegebenen Zeitpunkt entnommenen Probe gemessen. Die Kurve zeigt geschätzte Konzentrationen auf Basis der Dosiseinträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résultat d’analyse correspond à la mesure au moment du prélèvement. La courbe présente des concentrations estimées à partir des prises enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査結果は採取時点の実測値です。曲線の濃度は投薬記録をもとに算出した推定値です。"
          }
        }
      }
    },
    "Could not access local AI storage.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问本地 AI 存储。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den lokalen KI-Speicher konnte nicht zugegriffen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au stockage local de l’IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのAIストレージにアクセスできませんでした。"
          }
        }
      }
    },
    "Dose record: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
