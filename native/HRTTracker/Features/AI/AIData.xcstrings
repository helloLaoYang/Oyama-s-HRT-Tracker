    },
    "No dose records or measured lab results in this period.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该时段内没有用药记录或实测化验结果。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Zeitraum liegen keine Dosiseinträge oder gemessenen Laborwerte vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune prise ni aucun résultat d’analyse mesuré sur cette période."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間の投薬記録や実測検査結果はありません。"
          }
        }
      }
    },
    "No matching records for the requested dates were found in the selected period.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选时段内，未找到符合所问日期的记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im ausgewählten Zeitraum wurden für die angefragten Daten keine passenden Einträge gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun enregistrement correspondant aux dates demandées n’a été trouvé dans la période sélectionnée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間内で、指定された日付に該当する記録は見つかりませんでした。"
          }
        }
      }
    },
