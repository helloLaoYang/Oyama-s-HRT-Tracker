{
  "sourceLanguage": "en",
  "strings": {
    "Allow microphone access in Settings to record speech.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许麦克风访问，以录制语音。"
          }
        }
      }
    },
