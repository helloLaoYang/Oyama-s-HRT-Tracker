{
  "sourceLanguage": "en",
  "strings": {
    "Add attachment": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhang hinzufügen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une pièce jointe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルを追加"
          }
        }
      }
    },
    "Attach up to 4 files totaling no more than 16 MB.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多添加 4 个文件，总大小不超过 16 MB。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänge bis zu 4 Dateien mit insgesamt höchstens 16 MB an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez jusqu’à 4 fichiers pour un total de 16 Mo maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 4 件、合計 16 MB までのファイルを添付できます。"
          }
        }
      }
    },
