            "value": "テキストを追加"
          }
        }
      }
    },
    "Choose photo": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto auswählen"
          }
        },
        "fr": {
          "stringUnit": {
