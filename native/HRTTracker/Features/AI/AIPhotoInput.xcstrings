            "value": "Choisir une photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選択"
          }
        }
      }
    },
    "No readable text was found in this photo.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片中没有识别到可读文字。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Foto wurde kein lesbarer Text erkannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte lisible n’a été détecté sur cette photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真には読み取れるテキストがありませんでした。"
          }
        }
      }
    },
    "Read text from photo": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从照片识别文字"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text aus Foto lesen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire le texte d’une photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真からテキストを読み取る"
          }
        }
      }
    },
    "Reading photo…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在识别照片…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto wird gelesen …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture de la photo…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み取り中…"
          }
        }
      }
    },
    "Recognized text": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别结果"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannter Text"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte reconnu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識されたテキスト"
          }
        }
      }
    },
    "Review the values, units, and dates before adding the text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加前请核对数值、单位和日期。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Werte, Einheiten und Datumsangaben, bevor du den Text hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les valeurs, les unités et les dates avant d’ajouter le texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加する前に数値、単位、日付を確認してください。"
          }
        }
      }
    },
    "Shorten the text to %lld characters to add it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文字缩短至 %lld 字以内即可添加。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürze den Text auf %lld Zeichen, um ihn hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcissez le texte à %lld caractères pour l’ajouter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するにはテキストを %lld 文字以内に短くしてください。"
          }
        }
      }
    },
    "Text is recognized on this device. Only text you add goes into the draft.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在此设备上识别。只有你选择添加的文字会进入草稿。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird auf diesem Gerät erkannt. Nur hinzugefügter Text gelangt in den Entwurf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est reconnu sur cet appareil. Seul le texte que vous ajoutez figure dans le brouillon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストはこのデバイス上で認識されます。追加したテキストだけが下書きに入ります。"
          }
        }
      }
    },
    "This photo could not be read. Choose another photo.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这张照片。请选择另一张。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht gelesen werden. Wähle ein anderes Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n’a pas pu être lue. Choisissez une autre photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を読み取れませんでした。別の写真を選択してください。"
          }
        }
      }
    },
    "This photo is too large. Choose a smaller photo.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片过大。请选择一张较小的照片。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist zu groß. Wähle ein kleineres Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est trop volumineuse. Choisissez une photo plus petite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真はサイズが大きすぎます。サイズの小さい写真を選択してください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
