    "Could not reach the model service. Check your connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接模型服务。请检查网络连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modelldienst ist nicht erreichbar. Prüfe deine Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service de modèles. Vérifiez votre connexion."
