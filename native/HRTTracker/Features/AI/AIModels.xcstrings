{
  "sourceLanguage": "en",
  "strings": {
    "The offline model is unavailable on this device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法使用离线模型。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell ist auf diesem Gerät nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle hors ligne est indisponible sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではオフラインモデルを使用できません。"
          }
        }
      }
    },
    "The offline model files are missing or incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线模型文件缺失或不完整。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien des Offline-Modells fehlen oder sind unvollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du modèle hors ligne sont manquants ou incomplets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルのファイルが見つからないか、不完全です。"
          }
        }
      }
    },
    "The offline model is already generating a reply.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线模型正在生成回复。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell erstellt bereits eine Antwort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle hors ligne génère déjà une réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルはすでに応答を生成しています。"
          }
        }
      }
    },
    "The offline model returned an empty reply.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线模型返回了空回复。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell hat eine leere Antwort zurückgegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle hors ligne a renvoyé une réponse vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルから空の応答が返されました。"
          }
        }
      }
    },
    "The offline model is not installed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装离线模型。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell ist nicht installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle hors ligne n’est pas installé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルがインストールされていません。"
          }
        }
      }
    },
    "The offline model could not complete the request.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线模型未能完成请求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Offline-Modell konnte die Anfrage nicht abschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle hors ligne n’a pas pu traiter la demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインモデルはリクエストを完了できませんでした。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
