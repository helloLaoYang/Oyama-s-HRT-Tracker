    "Leave the provider limit blank if unknown. A short context is used until you verify it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不知道服务商的上限，请留空。确认前将使用较短的上下文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Anbieterlimit leer, wenn es unbekannt ist. Bis zur Bestätigung wird ein kurzer Kontext verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez la limite vide si elle est inconnue. Un contexte court est utilisé en attendant sa confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの上限が不明な場合は空欄にしてください。確認できるまでは短いコンテキストを使用します。"
          }
        }
      }
    },
