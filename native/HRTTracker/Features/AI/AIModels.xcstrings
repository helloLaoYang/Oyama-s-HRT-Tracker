        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスに接続できませんでした。ネットワーク接続を確認してください。"
          }
        }
      }
    },
    "Could not update the model settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新模型设置。"
