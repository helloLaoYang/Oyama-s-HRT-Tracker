    "Apple on-device model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Apple-Modell"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle Apple sur l’appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオンデバイスモデル"
          }
        }
      }
    },
    "Apple's on-device model could not complete this request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型未能完成此次请求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Apple-Modell konnte diese Anfrage nicht abschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple sur l’appareil n’a pas pu traiter cette demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオンデバイスモデルはこのリクエストを完了できませんでした。"
          }
        }
      }
    },
    "Apple's on-device model does not support this language.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型不支持此语言。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Apple-Modell unterstützt diese Sprache nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple sur l’appareil ne prend pas en charge cette langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオンデバイスモデルはこの言語に対応していません。"
          }
        }
      }
    },
    "Apple's on-device model is not ready yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型尚未就绪。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Apple-Modell ist noch nicht bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple sur l’appareil n’est pas encore prêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオンデバイスモデルの準備がまだできていません。"
          }
        }
      }
    },
    "Apple's on-device model is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型不可用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Apple-Modell ist nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple sur l’appareil est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのオンデバイスモデルを利用できません。"
          }
        }
      }
    },
    "Apple's on-device model requires iOS 26 or later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 端侧模型需要 iOS 26 或更高版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Apple-Modell erfordert iOS 26 oder neuer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple sur l’appareil nécessite iOS 26 ou une version ultérieure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleのオンデバイスモデルにはiOS 26以降が必要です。"
          }
        }
      }
    },
    "Available on this device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在本机使用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät verfügbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible sur cet appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで利用可能"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Attachments require a separate first confirmation. Changing the service address, model, API format, or key resets approval.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次发送附件时需单独确认。更改服务地址、模型、API 格式或密钥后，需要重新确认。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Senden von Anhängen ist eine separate Bestätigung nötig. Änderungen an Dienstadresse, Modell, API-Format oder Schlüssel setzen die Freigabe zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier envoi de pièces jointes nécessite une confirmation distincte. Un changement d’adresse du service, de modèle, de format API ou de clé annule l’autorisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルの初回送信には別途確認が必要です。サービスのアドレス、モデル、API形式、キーのいずれかを変更すると、承認がリセットされます。"
          }
        }
      }
    },
    "Choose a model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型"
          }
        },
        "de": {
