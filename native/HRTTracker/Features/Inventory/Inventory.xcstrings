        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Vorrat hinzu. Er wird beim Erfassen von Dosen automatisch angepasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre stock. Il se mettra à jour à chaque prise enregistrée."
